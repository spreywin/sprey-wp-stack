# Public hostname. Point its A/AAAA record to this server before starting Caddy.
DOMAIN=example.com

# E-mail used by Let's Encrypt for expiry and security notices.
ACME_EMAIL=admin@example.com

# Use long, unique random values. Do not commit the real .env file.
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=change-me-to-a-long-random-password
MYSQL_ROOT_PASSWORD=change-me-to-a-different-long-random-password

# Tested storefront plugin versions bundled into the WordPress image.
WOOCOMMERCE_VERSION=11.0.1
BTCPAY_WOOCOMMERCE_VERSION=2.8.0

# Optional image overrides. Defaults are moving stable/LTS tags; leave blank
# unless a tested exception is required for a particular deployment.
# CADDY_IMAGE=caddy:2-alpine
# WORDPRESS_IMAGE=sprey-wordpress:local
# MARIADB_IMAGE=mariadb:lts
# PHPMYADMIN_IMAGE=phpmyadmin:latest
